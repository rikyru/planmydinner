{
  "name": "Plan My Dinner",
  "version": "0.1.0",
  "slug": "planmydinner",
  "description": "Core logic and API for the Plan My Dinner integration.",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "startup": "application",
  "boot": "auto",
  "webui": "http://[HOST]:[PORT:8000]",
  "host_network": false,
  "ports": {
    "8000/tcp": 8000
  },
  "map": ["share"],
  "options": {
    "db_path": "/share/planmydinner/database.db"
  },
  "schema": {
    "db_path": "str"
  },
  "image": "ghcr.io/{owner}/{image}"
}
