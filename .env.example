# Plan My Dinner — configurazione LLM
# Copia questo file come .env e modifica i valori

# --- Scelta provider LLM ---
# Valori possibili: "openai" | "ollama"
LLM_PROVIDER=ollama

# --- OpenAI (se LLM_PROVIDER=openai) ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (se LLM_PROVIDER=ollama) ---
# Ollama deve essere raggiungibile dall'interno del container Docker.
# Se Ollama gira sull'host Mac/Linux usa: http://host.docker.internal:11434
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3

# --- Auth API (opzionale) ---
# Se impostata, tutte le chiamate API richiedono l'header X-API-Key (o ?api_key=).
# Se NON impostata l'API resta aperta come prima (retro-compatibile).
# La web UI salva la chiave passata una volta come /ui/?api_key=... nel browser.
# I client esterni (es. OpenFit) devono inviare l'header X-API-Key.
# API_KEY=una-chiave-segreta

# --- CORS (opzionale) ---
# Lista di origini separate da virgola. Default: * (tutti)
# IMPORTANTE: se accedi da HA su un dominio diverso devi specificare
# l'origine HA qui, altrimenti il popup "cambia ricetta" darà
# "failed to fetch" per la policy CORS con credenziali.
# Esempio Cloudflare (HA e planner su domini separati):
# CORS_ORIGINS=https://homeassistant.example.com,https://planmydinner.example.com
# CORS_ORIGINS=http://localhost:3000,http://mio-server.local
